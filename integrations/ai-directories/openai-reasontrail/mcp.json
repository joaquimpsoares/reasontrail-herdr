{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "reasontrail": {
      "type": "streamable-http",
      "url": "https://app.reasontrail.ai/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["brain:read", "brain:capture", "offline_access"]
          }
        }
      }
    }
  }
}
